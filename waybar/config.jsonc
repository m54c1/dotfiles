{
	"layer": "top",
	"position": "top",
	"gtk-layer-shell": true,
	"height": 25,
	"modules-left": [
		"sway/workspaces"
	],
	"modules-center": [
		"custom/weather",
		"clock",
		"sway/language"
	],
	"modules-right": [
		"tray",
		"memory",
		"pulseaudio"
	],
	"include": [],
	"sway/workspaces": {
		"all-outputs": true,
		"on-click": "activate"
	},
	"tray": {
		"icon-size": 18,
		"spacing": 15
	},
	"clock": {
    		"format": "{:%d|%H:%M}",
    		"tooltip-format": "{calendar}",
    		"calendar": {
      		"format": {
        		"months": "<span color='#ffead3'><b>{}</b></span>",
        		"weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        		"today": "<span color='#ffcc66'><b><u>{}</u></b></span>"
      			}
    		}
  	},
	"pulseaudio": {
		"format": "{icon} {volume}%",
		"tooltip": false,
		"format-muted": " Muted",
		"on-click": "wpctl set-mute @DEFAULT_SINK@ toggle",
		"on-click-right": "pavucontrol",
		"on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_SINK@ 1%+",
		"on-scroll-down": "wpctl set-volume @DEFAULT_SINK@ 1%-",
		"scroll-step": 1,
		"format-icons": {
			"headphone": "",
			"hands-free": "",
			"headset": "",
			"phone": "",
			"portable": "",
			"car": "",
			"default": ["", "", ""]
		}
	},
	"sway/language": {
       		"format": "  {}",
       		"format-en": "EN",
       		"format-ru": "RU"
    	},
	"memory": {
        	"format": " {used}gb/{total}gb",
		"tooltip": true
    	},
	"custom/weather": {
    		"exec": "~/.config/waybar/weather.sh",
    		"interval": 600,
    		"format": "{}"
	}
}
